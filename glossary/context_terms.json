{
  "_meta": {
    "purpose": "锁定玩家高频界面的定译，防止大小写变体/批量导入把已修好的译法改回旧值。",
    "how": "python integration/check_context_terms.py --check；mod/finalize.py 会调用。",
    "rule": "每个 key 必须与给定译文完全一致；新增术语先在这里登记再改词典。",
    "history": "v1.10.6 起因：Fair=非俄罗斯部队、Capacity=容量、Special=特殊技能、AP HITS=行政点伤害等，都是「按大小写/标点复用旧译」的一刀切留下的；其中大写键被人工覆盖修好，小写变体仍是旧值。"
  },
  "groups": {
    "weather_scale": {
      "check_case_variants": true,
      "terms": {
        "Night": "夜间",
        "Poor": "差",
        "Fair": "一般",
        "Good": "良好",
        "Excellent": "优秀",
        "> Poor": "差",
        "> Fair": "一般",
        "> Good": "良好",
        "Minimum Weather": "最低天气"
      }
    },
    "victory_result": {
      "check_case_variants": true,
      "terms": {
