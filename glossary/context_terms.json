        "AXIS MINOR": "轴心国小胜",
        "axis minor": "轴心国小胜",
        "ALLIED MAJOR": "盟军重大胜利",
        "allied major": "盟军重大胜利",
        "ALLIED MINOR": "盟军小胜",
        "allied minor": "盟军小胜",
